# .env.example – copy to .env and fill in your values

# ── Database ──────────────────────────────────────────────────────────────
# Default: SQLite file in the project root
DATABASE_URL=sqlite:///./agro_in.db

# Example PostgreSQL (uncomment and fill for production):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/agro_in

# Print all SQL queries to console (useful for debugging, disable in prod)
SQL_ECHO=false

# ── App ───────────────────────────────────────────────────────────────────
DEBUG=false

# ── File uploads ─────────────────────────────────────────────────────────
# Relative to the directory where uvicorn is run
UPLOAD_DIR=uploads
